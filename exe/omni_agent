#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

options = { fresh: false, path: false }
parser = OptionParser.new do |opts|
  opts.banner = <<~BANNER
    Usage: omni_agent eval [pattern] [options]
           omni_agent mcp <ServerClass>
           omni_agent docs [page] [--path]
  BANNER
  opts.on("--fresh", "Clear the eval cache before running") { options[:fresh] = true }
  opts.on("--path", "Print the path of the bundled docs instead of their contents") { options[:path] = true }
end

def require_rails_environment(command)
  environment_file = File.expand_path("config/environment", Dir.pwd)
  unless File.exist?("#{environment_file}.rb")
    abort "Could not find config/environment.rb -- run `omni_agent #{command}` from your Rails app root."
  end
  require environment_file
end

command = ARGV.shift

case command
when "eval"
  parser.parse!(ARGV)
  pattern = ARGV.shift

  require_rails_environment("eval")

  status = OmniAgent::Eval::CLI.run(pattern: pattern, fresh: options[:fresh])

  case status
  when :no_files
    abort "No eval files found matching #{(pattern || OmniAgent::Eval::CLI::DEFAULT_PATTERN).inspect}"
  when :no_evals
    abort "No OmniAgent::Eval subclasses found"
  when :failed
    exit 1
  end
when "mcp"
  server = ARGV.shift.to_s.strip
  if server.empty?
    warn "Missing server class. Example: omni_agent mcp SupportServer"
    exit 1
  end

  require_rails_environment("mcp")
  OmniAgent::MCP::Stdio.start(server)
when "docs"
  parser.parse!(ARGV)
  require_relative "../lib/omni_agent/docs"

  page = ARGV.shift
  file = OmniAgent::Docs.path(page || "index")
  unless file
    warn "Unknown docs page: #{page.inspect}. Available pages:"
    warn OmniAgent::Docs.pages.map { |name| "  #{name}" }
    exit 1
  end

  if options[:path]
    puts page ? file : OmniAgent::Docs.root
  else
    puts File.read(file)
  end
when nil
  warn parser.banner
  exit 1
else
  warn "Unknown command: #{command.inspect}"
  warn parser.banner
  exit 1
end
